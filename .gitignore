# Repositório mínimo: somente os diretórios e arquivos listados abaixo.
/*
!/.gitignore
!/.vercelignore
!/.env.example
!/README.md
!/package.json
!/package-lock.json
!/vercel.json
!/api/
!/src/
!/public/
!/views/
!/database/
!/scripts/
!/certs/

# Migrações e verificações necessárias; documentação/testes permanecem locais.
/database/*
!/database/migrate.js
!/database/migrations/
/database/migrations/*
!/database/migrations/[0-9][0-9][0-9]_*.sql
/scripts/*
!/scripts/check-production.js
!/scripts/check-publication.js
/certs/*
!/certs/supabase-ca.crt

# Nunca publicar segredos, cópias, dados locais ou material de ferramentas.
**/node_modules/
**/.env
**/.env.*
!/.env.example
**/.vercel/
**/.aws/
**/.agents/
**/.codex/
**/.git/
**/.gitkeep
**/*.key
**/*.p12
**/*.pfx
**/*.pem
**/id_rsa*
**/id_ed25519*
**/credentials*
**/*.log
**/*.bak
**/*.backup
**/*.dump
**/*.sqlite*
**/*.db
**/*~
**/.DS_Store
