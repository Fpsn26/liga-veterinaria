NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/liga_veterinaria
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
# Preencha somente no .env local; não há credenciais padrão.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Gere um segredo aleatório de pelo menos 32 bytes.
SESSION_SECRET=
# Opcional: loopback apenas se o proxy HTTPS confiável estiver na mesma máquina.
# Na Vercel, deixe vazio; o código reconhece o proxy pela variável da plataforma.
TRUST_PROXY=
